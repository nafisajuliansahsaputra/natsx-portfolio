{
  "name": "natsx-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "optimize:3d": "node scripts/optimize-3d.mjs",
    "prebuild": "node scripts/optimize-3d.mjs --vercel && node scripts/audit-media-resilience.mjs --ci",
    "backup:portfolio": "node scripts/backup-portfolio-media.mjs",
    "mirror:portfolio": "node scripts/publish-portfolio-media-mirror.mjs",
    "audit:media": "node scripts/audit-media-resilience.mjs",
    "predev": "node scripts/optimize-3d.mjs --prepare-only",
    "audit:orphans": "node scripts/audit-portfolio-orphans.mjs",
    "cleanup:orphans": "node scripts/audit-portfolio-orphans.mjs --delete",
    "backup:portfolio:full": "node scripts/backup-portfolio-media.mjs --include-orphans"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
