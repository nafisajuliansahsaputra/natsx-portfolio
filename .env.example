NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional mirrored portfolio media delivery.
# Keep empty until the mirror contains the same <bucket>/<path> keys.
NEXT_PUBLIC_PORTFOLIO_MEDIA_CDN_PREFIX=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

OPENROUTER_API_KEY=
NATSX_TRANSLATION_MODEL=openrouter/free
# Cloudinary signed uploads. Configure locally and in Vercel before enabling
# new CMS image uploads. Cloud name is public, credentials are server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
